EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-me
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-me
EXPO_PUBLIC_FIREBASE_MEDIA_BUCKET=replace-me
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me

# Current setup: Expo Go on mobile and MapLibre/MapTiler on local Web.
# Mobile react-native-maps does not consume this key.
# Never commit the real value from client/.env.
EXPO_PUBLIC_MAPTILER_KEY=replace-with-local-testing-key

# Add an origin-restricted key only when a Web domain is deployed.
EXPO_PUBLIC_MAPTILER_WEB_KEY=
