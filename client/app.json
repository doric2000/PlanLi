{
  "expo": {
    "name": "PlanLi Travels",
    "slug": "client",
    "scheme": "com.planli.planlitravels",
    "version": "1.1.0",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/04731493-708f-4c82-b417-6ea815ea912e"
    },
    "owner": "doric2000",
    "orientation": "portrait",
    "icon": "./assets/brand-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.planli.planlitravels",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PlanLi משתמשת במיקום שלך כדי למיין המלצות ויעדים לפי הקרבה אליך.",
        "NSMotionUsageDescription": "PlanLi משתמשת בנתוני התנועה של המכשיר כחלק משירותי המיקום, כדי לשפר את דיוק המיקום ולהציג יעדים והמלצות רלוונטיים בקרבתך.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.planli.planlitravels",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/brand-favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlanLi משתמשת במיקום שלך כדי למיין המלצות ויעדים לפי הקרבה אליך.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/app-check",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "react-native-maps",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlanLi מבקשת גישה לתמונות שבחרת כדי להעלות תמונת פרופיל, המלצה או מסלול.",
          "cameraPermission": "PlanLi מבקשת גישה למצלמה כדי לצלם ולהעלות תמונה לפרופיל, להמלצה או למסלול.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PlanLi מבקשת גישה לתמונות שבחרת כדי להוסיף אותן להמלצה או למסלול.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "04731493-708f-4c82-b417-6ea815ea912e"
      }
    }
  }
}
