{
  "expo": {
    "name": "PlanLi Travels",
    "slug": "client",
    "scheme": "client",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04731493-708f-4c82-b417-6ea815ea912e"
    },
    "owner": "doric2000",
    "orientation": "portrait",
    "icon": "./assets/brand-app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.planli.planlitravels",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PlanLi משתמשת במיקום שלך כדי למיין המלצות ויעדים לפי הקרבה אליך.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.planli.planlitravels",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/brand-favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlanLi מבקשת גישה לתמונות שבחרת כדי להעלות תמונת פרופיל, המלצה או מסלול.",
          "cameraPermission": "PlanLi מבקשת גישה למצלמה כדי לצלם ולהעלות תמונה לפרופיל, להמלצה או למסלול.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "04731493-708f-4c82-b417-6ea815ea912e"
      }
    }
  }
}
