{
  "cli": {
    "version": "22.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "PLANLI_ENV": "development",
        "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "e2e-test": {
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "PLANLI_ENV": "staging"
      },
      "node": "22.23.1",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "PLANLI_ENV": "staging"
      },
      "node": "22.23.1",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "release-candidate": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "PLANLI_ENV": "release-candidate"
      },
      "node": "22.23.1",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "PLANLI_ENV": "production"
      },
      "node": "22.23.1",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6801453067"
      }
    }
  }
}
