rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function bounded(maximum) {
      return request.query.limit != null
        && request.query.limit > 0
        && request.query.limit <= maximum;
    }

    function activeResource() {
      return resource.data.status == 'active';
    }

    function activeParent(collectionName, contentId) {
      return get(
        /databases/$(database)/documents/$(collectionName)/$(contentId)
      ).data.status == 'active';
    }

    function activeCountry(countryId) {
      return get(
        /databases/$(database)/documents/countries/$(countryId)
      ).data.status == 'active';
    }

    function activeRouteRevision(contentId, revisionId) {
      let route = get(
        /databases/$(database)/documents/routes/$(contentId)
      );
      let revision = get(
        /databases/$(database)/documents/routes/$(contentId)/revisions/$(revisionId)
      );
      return route.data.status == 'active'
        && route.data.activeRevisionId == revisionId
        && revision.data.state == 'active';
    }

    // Business documents are written exclusively through callable Functions.
    match /recommendations/{contentId} {
      allow get: if admin() || activeResource();
      allow list: if admin() || (bounded(50) && activeResource());
      allow write: if false;

      match /likes/{userId} {
        allow get: if admin() || activeParent('recommendations', contentId);
        allow list: if admin() || (bounded(30) && activeParent('recommendations', contentId));
        allow write: if false;
      }

      match /comments/{commentId} {
        allow get: if admin() || activeParent('recommendations', contentId);
        allow list: if admin() || (bounded(30) && activeParent('recommendations', contentId));
        allow write: if false;
      }
    }

    match /routes/{contentId} {
      allow get: if admin() || activeResource();
      allow list: if admin() || (bounded(50) && activeResource());
      allow write: if false;

      match /days/{dayId} {
        allow get: if activeParent('routes', contentId);
        allow list: if bounded(60) && activeParent('routes', contentId);
        allow write: if false;

        match /stops/{stopId} {
          allow get: if activeParent('routes', contentId);
          allow list: if bounded(150) && activeParent('routes', contentId);
          allow write: if false;
        }
      }

      match /revisions/{revisionId} {
        allow get: if admin() || activeRouteRevision(contentId, revisionId);
        allow list, write: if false;

        match /days/{dayId} {
          allow get: if admin() || activeRouteRevision(contentId, revisionId);
          allow list: if admin() || (
            bounded(60) && activeRouteRevision(contentId, revisionId)
          );
          allow write: if false;

          match /stops/{stopId} {
            allow get: if admin() || activeRouteRevision(contentId, revisionId);
            allow list: if admin() || (
              bounded(150) && activeRouteRevision(contentId, revisionId)
            );
            allow write: if false;
          }
        }
      }

      match /likes/{userId} {
        allow get: if admin() || activeParent('routes', contentId);
        allow list: if admin() || (bounded(30) && activeParent('routes', contentId));
        allow write: if false;
      }

      match /comments/{commentId} {
        allow get: if admin() || activeParent('routes', contentId);
        allow list: if admin() || (bounded(30) && activeParent('routes', contentId));
        allow write: if false;
      }
    }

    match /trips/{contentId} {
      allow get: if admin() || activeResource();
      allow list: if admin() || (bounded(50) && activeResource());
      allow write: if false;

      match /likes/{userId} {
        allow get: if admin() || activeParent('trips', contentId);
        allow list: if admin() || (bounded(30) && activeParent('trips', contentId));
        allow write: if false;
      }

      match /comments/{commentId} {
        allow get: if admin() || activeParent('trips', contentId);
        allow list: if admin() || (bounded(30) && activeParent('trips', contentId));
        allow write: if false;
      }
    }

    match /countries/{countryId} {
      allow get: if admin() || activeResource();
      allow list: if admin() || (bounded(250) && activeResource());
      allow write: if false;

      match /cities/{cityId} {
        allow get: if admin() || (
          resource.data.countryId == countryId
          && activeCountry(countryId)
          && activeResource()
        );
        allow list: if admin() || (
          bounded(100)
          && activeCountry(countryId)
          && activeResource()
        );
        allow write: if false;
      }
    }

    // Required for collectionGroup('cities').
    match /{parentPath=**}/cities/{cityId} {
      // A collection-group query cannot prove the dynamic parent country's
      // publication state. Public cross-country search uses destinationCatalog.
      allow get, list: if admin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if admin() || (signedIn() && request.auth.uid == userId);
      allow list, write: if false;

      match /favorites/{favoriteId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if signedIn() && request.auth.uid == userId && bounded(50);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if signedIn() && request.auth.uid == userId && bounded(50);
        allow write: if false;
      }

      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /system/{systemDocument=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
