rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model: public active content lives in recommendations/routes/trips
    // with server-written likes/comments children; route revisions are immutable.
    // countries/destinations expose only active catalog data, publicProfiles contains
    // approved public identity, and users/{uid} is private. Favorites, blocked users,
    // notifications and notification state are owner-scoped and server-written.
    // Notification rows require schemaVersion/channel/type/subtype/priority/isRead/
    // createdAt plus bounded server-sanitized previews and ID-only navigation actions.
    // notificationDevices and all system/** moderation/runtime records are server-only.
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == userId;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function admin() {
      return signedIn()
        && request.auth.token.admin == true
        && exists(
          /databases/$(database)/documents/system/moderation/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/system/moderation/admins/$(request.auth.uid)
        ).data.active == true;
    }

    function bounded(maximum) {
      return request.query.limit != null
        && request.query.limit > 0
        && request.query.limit <= maximum;
    }

    function canReadNotification(userId) {
      return isOwner(userId)
        && (
          resource.data.channel == 'personal'
          || (resource.data.channel == 'admin' && admin())
        );
    }

    function activeResource() {
      return resource.data.status == 'active';
    }

    function activePublicContent() {
      return activeResource()
        && resource.data.publicationGate.destinationApprovalVerified == true;
    }

    function activeParent(collectionName, contentId) {
      return get(
        /databases/$(database)/documents/$(collectionName)/$(contentId)
      ).data.status == 'active'
        && get(
          /databases/$(database)/documents/$(collectionName)/$(contentId)
        ).data.publicationGate.destinationApprovalVerified == true;
    }

    function activeComment(collectionName, contentId) {
      return activeParent(collectionName, contentId)
        && resource.data.status == 'active'
        && (
          !('threadType' in resource.data)
          || resource.data.threadType == 'root'
          || (
            resource.data.threadType == 'reply'
            && resource.data.threadRootId is string
            && get(
              /databases/$(database)/documents/$(collectionName)/$(contentId)/comments/$(resource.data.threadRootId)
            ).data.status == 'active'
          )
        );
    }

    function activeCountry(countryId) {
      return get(
        /databases/$(database)/documents/countries/$(countryId)
      ).data.status == 'active';
    }

    function activeDestinationCache() {
      return resource.data.schemaVersion < 3
        || resource.data.googleCache.expiresAt > request.time;
    }

    function approvedCanonicalDestination(countryId) {
      return resource.data.canonicalPolicy.approved == true
        && resource.data.canonicalPolicy.registryId is string
        && resource.data.canonicalPolicy.registryVersion >= 1
        && resource.data.canonicalPolicy.approvalRevision >= 1
        && resource.data.canonicalPolicy.registryAttestation.approved == true
        && resource.data.canonicalPolicy.registryAttestation.registryId
          == resource.data.canonicalPolicy.registryId
        && resource.data.canonicalPolicy.registryAttestation.registryVersion
          == resource.data.canonicalPolicy.registryVersion
        && resource.data.canonicalPolicy.registryAttestation.approvalRevision
          == resource.data.canonicalPolicy.approvalRevision
        && resource.data.canonicalPolicy.registryAttestation.countryId == countryId;
    }

    function activeRouteRevision(contentId, revisionId) {
      let route = get(
        /databases/$(database)/documents/routes/$(contentId)
      );
      let revision = get(
        /databases/$(database)/documents/routes/$(contentId)/revisions/$(revisionId)
      );
      return route.data.status == 'active'
        && route.data.publicationGate.destinationApprovalVerified == true
        && route.data.activeRevisionId == revisionId
        && revision.data.state == 'active';
    }

    // Business documents are written exclusively through callable Functions.
    match /recommendations/{contentId} {
      allow get: if admin() || activePublicContent();
      allow list: if admin() || (bounded(50) && activePublicContent());
      allow write: if false;

      match /likes/{userId} {
        allow get: if admin() || activeParent('recommendations', contentId);
        allow list: if admin() || (bounded(30) && activeParent('recommendations', contentId));
        allow write: if false;
      }

      match /comments/{commentId} {
        allow get: if admin() || activeComment('recommendations', contentId);
        allow list: if admin() || (bounded(30) && activeComment('recommendations', contentId));
        allow write: if false;
      }
    }

    match /routes/{contentId} {
      allow get: if admin() || activePublicContent();
      allow list: if admin() || (bounded(50) && activePublicContent());
      allow write: if false;

      match /days/{dayId} {
        allow read: if false;
        allow write: if false;

        match /stops/{stopId} {
          allow read: if false;
          allow write: if false;
        }
      }

      match /revisions/{revisionId} {
        allow get: if admin() || activeRouteRevision(contentId, revisionId);
        allow list, write: if false;

        match /days/{dayId} {
          allow get: if admin() || activeRouteRevision(contentId, revisionId);
          allow list: if admin() || (
            bounded(60) && activeRouteRevision(contentId, revisionId)
          );
          allow write: if false;

          match /stops/{stopId} {
            allow get: if admin() || activeRouteRevision(contentId, revisionId);
            allow list: if admin() || (
              bounded(150) && activeRouteRevision(contentId, revisionId)
            );
            allow write: if false;
          }
        }
      }

      match /likes/{userId} {
        allow get: if admin() || activeParent('routes', contentId);
        allow list: if admin() || (bounded(30) && activeParent('routes', contentId));
        allow write: if false;
      }

      match /comments/{commentId} {
        allow get: if admin() || activeComment('routes', contentId);
        allow list: if admin() || (bounded(30) && activeComment('routes', contentId));
        allow write: if false;
      }
    }

    match /trips/{contentId} {
      allow get: if admin() || activePublicContent();
      allow list: if admin() || (bounded(50) && activePublicContent());
      allow write: if false;

      match /likes/{userId} {
        allow get: if admin() || activeParent('trips', contentId);
        allow list: if admin() || (bounded(30) && activeParent('trips', contentId));
        allow write: if false;
      }

      match /comments/{commentId} {
        allow get: if admin() || activeComment('trips', contentId);
        allow list: if admin() || (bounded(30) && activeComment('trips', contentId));
        allow write: if false;
      }
    }

    match /countries/{countryId} {
      allow get: if admin() || activeResource();
      allow list: if admin() || (bounded(250) && activeResource());
      allow write: if false;

      match /destinations/{cityId} {
        allow get: if admin() || (
          resource.data.countryId == countryId
          && activeCountry(countryId)
          && activeResource()
          && approvedCanonicalDestination(countryId)
          && activeDestinationCache()
        );
        // Cross-destination discovery is served by the bounded callable catalog.
        // Firestore cannot prove each child's expiring cache in a collection query.
        allow list: if admin();
        allow write: if false;
      }
    }

    // Required for collectionGroup('destinations').
    match /{parentPath=**}/destinations/{cityId} {
      // A collection-group query cannot prove the dynamic parent country's
      // publication state. Public cross-country search uses destinationCatalog.
      allow get, list: if admin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if admin() || isOwner(userId);
      allow list, write: if false;

      match /favorites/{favoriteId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && bounded(50);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow get: if canReadNotification(userId);
        allow list: if canReadNotification(userId) && bounded(25);
        allow write: if false;
      }

      match /notificationState/{stateId} {
        allow get: if isOwner(userId) && stateId == 'state';
        allow list: if false;
        allow write: if false;
      }

      match /blockedUsers/{blockedUserId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && bounded(250);
        allow write: if false;
      }

      match /{privateDocument=**} {
        allow read, write: if false;
      }
    }

    match /notificationDevices/{tokenHash} {
      allow read, write: if false;
    }

    match /publicProfiles/{userId} {
      allow get: if resource.data.status == 'active';
      allow list, write: if false;
    }

    match /system/{systemDocument=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
