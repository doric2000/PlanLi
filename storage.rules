rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && (
          request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true
        );
    }

    function activeAccount() {
      let user = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
      return verified()
        && user.displayName is string
        && user.displayName.size() >= 2
        && user.onboarding.profileDetailsVersion == 1
        && user.onboarding.profileDetailsCompletedAt != null
        && user.legal.termsVersion == '2026-08-14-draft'
        && user.legal.privacyVersion == '2026-08-14-draft'
        && user.legal.acceptedAt != null
        && user.smartProfile.setupRequired == false
        && user.smartProfile.completedAt != null;
    }

    match /media-staging/{uid}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if activeAccount()
        && request.auth.uid == uid
        && resource == null
        && fileName.matches(
          '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\\.jpg$'
        )
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.variant == 'staging';
      allow update: if false;
    }

    match /media/{uid}/{assetId}/{variantFile} {
      allow get: if true;
      allow list, write: if false;
    }

    match /destinations/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /countries/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    // Existing public objects remain readable during the verified EU cutover.
    match /optimized/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /profilePicture/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /recommendations/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /routes/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /trips/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
