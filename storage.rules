rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && (
          request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true
        );
    }

    function activeAccount() {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      let user = firestore.get(userPath);
      return verified()
        && firestore.exists(userPath)
        && user.data.displayName is string
        && user.data.displayName.size() >= 2
        // BEGIN GENERATED LEGAL POLICY
        && user.data.onboarding.profileDetailsVersion == 1
        && user.data.onboarding.profileDetailsCompletedAt != null
        && user.data.legal.termsVersion == '2026-08-15-community-safety'
        && user.data.legal.privacyVersion == '2026-08-18-beta-observability'
        // END GENERATED LEGAL POLICY
        && user.data.legal.acceptedAt != null
        && user.data.moderation.status == 'active';
    }

    match /media-staging/{uid}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if activeAccount()
        && request.auth.uid == uid
        && resource == null
        && fileName.matches(
          '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\\.jpg$'
        )
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.variant == 'staging';
      allow update: if false;
    }

    match /media/{uid}/{assetId}/{variantFile} {
      allow get: if assetId.matches(
          '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
        )
        && variantFile in ['large.webp', 'feed.webp', 'thumb.webp']
        && firestore.exists(
          /databases/(default)/documents/system/media/assets/$(assetId)
        ) && firestore.get(
          /databases/(default)/documents/system/media/assets/$(assetId)
        ).data.status == 'active'
        && firestore.get(
          /databases/(default)/documents/system/media/assets/$(assetId)
        ).data.ownerUid == uid;
      allow list, write: if false;
    }

    match /destinations/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /countries/{path=**} {
      allow get: if true;
      allow list, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
