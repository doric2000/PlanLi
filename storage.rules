rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function verified() {
      return signedIn()
        && (
          request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.email_verified == true
        );
    }

    function uuid(value) {
      return value.matches(
        '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
      );
    }

    match /media-staging/{uid}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && resource == null
        && fileName.matches(
          '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\\.jpg$'
        )
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.variant == 'staging';
      allow update: if false;
    }

    // Final immutable media is written and deleted only by Admin SDK code.
    match /media/{uid}/{assetId}/{variantFile} {
      allow read: if true;
      allow write: if false;
    }

    match /destinations/{destinationPath=**} {
      allow read: if true;
      allow write: if false;
    }

    match /countries/{destinationPath=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
