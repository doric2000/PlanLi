    "firebase-admin": "13.10.0",
    "firebase-functions": "7.3.2",
    "geofire-common": "^6.0.0",
    "sharp": "^0.35.3",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "12.17.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
