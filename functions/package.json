{
  "name": "planli-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test",
    "test:rules": "node --test rules.test.js",
    "test:rules:emulator": "firebase emulators:exec --project planli-rules-test --only firestore,storage \"npm run test:rules\"",
    "lint": "echo 'no lint configured'",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "bootstrap-admin": "node scripts/bootstrapAdmin.js",
    "set-email-verified": "node scripts/setEmailVerified.js",
    "migrate-media": "node scripts/migrateCanonicalMedia.js",
    "cleanup-orphan-favorites": "node scripts/cleanupOrphanFavorites.js",
    "backfill-public-profiles": "node scripts/backfillPublicProfiles.js",
    "sync-country-metadata": "node scripts/syncCountryMetadata.js",
    "migrate-destination-schema": "node scripts/migrateDestinationSchema.js",
    "build-country-geo": "node scripts/buildCountryGeoData.js"
  },
  "dependencies": {
    "countries-list": "3.4.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "sharp": "^0.35.3",
    "thumbhash": "0.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0"
  }
}
