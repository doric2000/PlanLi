    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "bootstrap-admin": "node scripts/bootstrapAdmin.js",
    "set-email-verified": "node scripts/setEmailVerified.js",
    "migrate-media": "node scripts/migrateCanonicalMedia.js",
    "migrate-storage-eu": "node scripts/migrateStorageToEurope.js",
    "migrate-database": "node scripts/migrateDatabaseCanonical.js",
    "migrate-personalization": "node scripts/migrateTravelPersonalization.js",
    "curate-recommendations": "node scripts/curateRecommendations.js",
    "audit-live": "node scripts/auditLiveState.js",
    "configure-function-iam": "node scripts/configureFunctionServiceAccounts.js",
    "cleanup-orphan-favorites": "node scripts/cleanupOrphanFavorites.js",
    "backfill-favorite-previews": "node scripts/backfillFavoritePreviews.js",
    "backfill-map-locations": "node scripts/backfillRecommendationMapLocations.js",
    "backfill-destination-images": "node scripts/backfillDestinationImages.js",
    "backfill-destination-catalog": "node scripts/backfillDestinationCatalog.js",
    "repair-destination-image-queries": "node scripts/repairDestinationImageQueries.js",
